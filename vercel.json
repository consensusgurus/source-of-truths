{
  "crons": [
    {
      "path": "/api/cron/consensus-check",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/housing?part=macro",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/housing?part=sec-builders",
      "schedule": "35 13 * * *"
    },
    {
      "path": "/api/cron/housing?part=sec-distributors",
      "schedule": "40 13 * * *"
    },
    {
      "path": "/api/cron/housing?part=sec-products",
      "schedule": "45 13 * * *"
    },
    {
      "path": "/api/cron/housing?part=metros",
      "schedule": "50 13 * * *"
    },
    {
      "path": "/api/cron/newsletter",
      "schedule": "0 12,13 * * *"
    },
    {
      "path": "/api/cron/stats-warm",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/cron/drawing-warm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/iq-field",
      "schedule": "*/10 * * * *"
    }
  ],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "functions": {
    "app/api/quiz/**/*.js": {
      "maxDuration": 60
    },
    "app/api/challenge/**/*.js": {
      "maxDuration": 60
    },
    "app/api/groups/**/*.js": {
      "maxDuration": 60
    }
  }
}
